// Checkpoint Database Schema
// PostgreSQL schema matching technical requirements for attendance tracking,
// QR code scanning, role-based workflows, and administrative event approvals.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  ATTENDEE
  STAFF
  ORGANIZER
}

enum TicketType {
  STUDENT
  REGULAR
  VIP
  SPEAKER
  ORGANIZER
}

enum TicketStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
}

enum CheckpointType {
  MAIN_ENTRY
  SESSION
  BOOTH
  EXIT
}

enum EventApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScanResult {
  SUCCESS
  DUPLICATE
  WARNING_NO_MAIN_ENTRY
  INVALID_TICKET
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  fullName           String
  role               UserRole  @default(USER)
  studentId          String?
  contactNumber      String?
  affiliation        String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  organizedEvents           Event[]           @relation("OrganizedEvents")
  eventOrganizerAssignments EventOrganizer[]
  tickets                   Ticket[]
  eventStaffAssignments     EventStaff[]
  checkpointAssignments     CheckpointStaff[]
  scannedLogs               AttendanceLog[]   @relation("ScannedByStaff")
  reviewedEvents            Event[]           @relation("ReviewedEvents")
  savedProfiles             SavedProfile[]

  @@map("users")
}

model SavedProfile {
  id            String   @id @default(uuid())
  userId        String
  profileName   String
  fullName      String
  studentId     String?
  contactNumber String?
  affiliation   String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_profiles")
}

model Event {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  description  String?
  venueName    String
  startDate    DateTime
  endDate      DateTime
  capacity     Int?
  allowWalkIns Boolean   @default(false)
  isPrivate    Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Organizer-submitted events start as PENDING until an admin reviews them.
  // Private events or admin-created events default to APPROVED.
  approvalStatus EventApprovalStatus @default(APPROVED)
  reviewNotes    String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?               @relation("ReviewedEvents", fields: [reviewedById], references: [id], onDelete: SetNull)

  organizerId String
  organizer   User   @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Restrict)

  organizers  EventOrganizer[]
  checkpoints Checkpoint[]
  tickets     Ticket[]
  staff       EventStaff[]

  @@map("events")
}

model EventOrganizer {
  id         String   @id @default(uuid())
  eventId    String
  userId     String
  assignedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_organizers")
}

model EventStaff {
  id         String   @id @default(uuid())
  eventId    String
  userId     String
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_staff")
}

model CheckpointStaff {
  id           String   @id @default(uuid())
  checkpointId String
  userId       String
  assignedAt   DateTime @default(now())
  isActive     Boolean  @default(true)

  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([checkpointId, userId])
  @@map("checkpoint_staff")
}

model Ticket {
  id             String       @id @default(uuid())
  eventId        String
  userId         String?
  firstName      String
  lastName       String
  email          String
  studentId      String?
  contactNumber  String?
  affiliation    String?
  ticketType     TicketType   @default(STUDENT)
  ticketCode     String       @unique
  qrPayload      String
  status         TicketStatus @default(REGISTERED)
  firstScannedAt DateTime?
  lastScannedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendanceLogs AttendanceLog[]

  @@unique([eventId, email])
  @@map("tickets")
}

model AttendanceLog {
  id              String     @id @default(uuid())
  ticketId        String?
  ticketCode      String
  checkpointId    String
  scannedByUserId String
  scannedAt       DateTime   @default(now())
  scanDate        DateTime   @default(now())
  scanResult      ScanResult @default(SUCCESS)
  deviceInfo      String?
  notes           String?
  createdAt       DateTime   @default(now())

  ticket     Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  scannedBy  User       @relation("ScannedByStaff", fields: [scannedByUserId], references: [id], onDelete: Restrict)

  @@index([checkpointId, scannedAt])
  @@index([ticketCode, scannedAt])
  @@map("attendance_logs")
}

model Checkpoint {
  id                 String         @id @default(uuid())
  eventId            String
  parentId           String?
  name               String
  location           String?
  type               CheckpointType @default(MAIN_ENTRY)
  allowMultipleScans Boolean        @default(false)
  requireMainEntry   Boolean        @default(false)
  isActive           Boolean        @default(true)
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent         Checkpoint?       @relation("SubBooths", fields: [parentId], references: [id], onDelete: SetNull)
  children       Checkpoint[]      @relation("SubBooths")
  assignedStaff  CheckpointStaff[]
  attendanceLogs AttendanceLog[]

  @@index([parentId])
  @@map("checkpoints")
}